# Export these in your shell; the pipeline does not automatically load .env.
BASE_MODEL_PATH=/path/to/Qwen3-4B-Base
TEACHER_BASE_URL=https://your-teacher-endpoint/v1
TEACHER_MODEL=your-teacher-model
COLD_SFT_API_KEY=replace-me
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
WANDB_MODE=offline

# Hard: public integration benchmarks.
ANTIDERIVBENCH_ROOT=/path/to/AntiderivBench
# Required for multi-round seed expansion.
EMBED_MODEL_PATH=/path/to/Qwen3-Embedding-8B

# Soft only.
SOFT_VERIFIER_BASE_URL=https://your-verifier-endpoint/v1
SOFT_VERIFIER_MODEL=your-verifier-model
SOFT_VERIFIER_API_KEY=replace-me
